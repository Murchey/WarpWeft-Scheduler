# WarpWeft Linux server environment.
# Copy to /etc/warpweft/warpweft.env and edit as needed.

WARPVEFT_PORT=4317
WARPVEFT_DATA_DIR=/var/lib/warpweft

# Linux 端默认启用登录；不要在生产环境设为 0（桌面版不使用此变量）。
WARPVEFT_AUTH=1

# Optional force-bind override. Leave commented so changes made in the UI
# (服务端 → 局域网共享 → 监听模式) survive service restarts.
# WARPVEFT_HOST=0.0.0.0

# Optional solver path/JDK overrides.
# WARPVEFT_SOLVER_JAR=/opt/warpweft/resources/solver/warpweft-solver.jar
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# 官网构建期注入项（npm run build:site 时读取，不是运行时变量）：
#   VITE_DOWNLOAD_URL  桌面版安装包直链；未设置时官网不显示「下载桌面版」按钮。
#   VITE_SITE_ORIGIN  站点规范地址（如 https://warpweft.example.edu）；用于 SEO。
#
# Keep enabled behind an Nginx instance on the same host. Set to 0 if the
# service is directly exposed and you do not want forwarded-IP headers used.
WARPVEFT_TRUST_PROXY=1
