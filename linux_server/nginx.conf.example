# WarpWeft Scheduler — Linux 服务端单域名配置。
#
# 复制到 /etc/nginx/conf.d/warpweft.conf 后，部署者只需要修改 server_name 一行。
#
# Linux 服务端只承担三件事：官网、运行状态监控、供桌面端调用的 API。
# **不提供排课界面**：排课/导入/调代课等全部功能在 Electron 桌面端完成。
#
#   /        产品介绍官网（公开，Nginx 直接提供静态文件，不经过 Node）
#   /site/   官网资源（公开，静态文件）
#   /api/    后端接口（除 /api/health 与 /api/auth/login 外均需登录）
#   /app/    刻意不提供（返回 404），避免把桌面 UI 搬到浏览器
#
# 官网「运行状态」区块登录管理员账号后可查看服务端负载与任务队列。
#
# Node 服务保持在 127.0.0.1:4317，不要把它直接暴露到公网。
# 公网部署必须启用 TLS：sudo certbot --nginx -d <你的域名> --redirect

upstream warpweft_server {
    server 127.0.0.1:4317;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;

    # ★★★ 部署时唯一必改项：改成你自己的子域名 ★★★
    # 例如：server_name warpweft.example.edu;
    server_name _;

    # 整个工作区作为一个 JSON 文档保存（服务端上限 5 MiB）
    client_max_body_size 8m;

    # ---------- 1) 官网资源：完全绕过 Node ----------
    # 官网的 base 是 /site/，所有资源都落在这里，永远不会与应用 bundle 撞车。
    location ^~ /site/assets/ {
        root /opt/warpweft/dist;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }
    # 部署配置必须每次回源校验：运维改完备案号/公告后刷新即生效，
    # 不能被下面的 1 小时缓存挡住。^~ 更长前缀优先，故需单独列出。
    location = /site/site-config.json {
        root /opt/warpweft/dist;
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
        # Nginx 的 mime.types 已把 .json 映射为 application/json，无需手写 Content-Type。
        access_log off;
    }
    location ^~ /site/ {
        root /opt/warpweft/dist;
        # 禁止回落：若落到 Node 的 SPA 兜底会返回 text/html，浏览器会拒绝执行 module 导致白屏
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
        access_log off;
    }

    # ---------- 2) 官网首页 ----------
    location = / {
        root /opt/warpweft/dist;
        try_files /site/index.html =404;
        default_type text/html;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    # /index.html 历史上是应用入口，现在让给官网
    location = /index.html { return 301 /; }
    location = /site/      { return 301 /; }

    # ---------- 3) 桌面端 UI：Linux 端不提供 ----------
    # 排课界面只在 Electron 桌面端运行；Linux 服务端只做监控与 API。
    # 显式拒绝而不是交给 Node，避免把「浏览器里跑排课」这种形态复活。
    location = /app { return 404; }
    location ^~ /app/ { return 404; }

    # ---------- 4) 后端接口 ----------
    location ^~ /api/ {
        proxy_pass http://warpweft_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }

    # ---------- 5) 其余路径交给 Node（如 /icon.svg），未命中会得到 404 ----------
    location / {
        proxy_pass http://warpweft_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }

    # Basic Auth 是可选的第二层保护。
    # ★ 只能放在 /api/ 的 location 内部——写在 server 级会把本应公开的官网首页也加上弹窗，
    #   而官网「运行状态」区块的登录框同样会被这一步挡住。
    #
    # auth_basic "WarpWeft";
    # auth_basic_user_file /etc/nginx/.htpasswd;
}
