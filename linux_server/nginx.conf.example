# WarpWeft Scheduler — same-origin reverse proxy.
# Put this in /etc/nginx/conf.d/warpweft.conf (or sites-available) and adjust
# server_name/TLS. Keep the Node service on 127.0.0.1:4317.

upstream warpweft_server {
    server 127.0.0.1:4317;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    # The whole workspace is saved as one JSON document (server cap is 5 MiB).
    client_max_body_size 8m;

    location / {
        proxy_pass http://warpweft_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, never append: the application trusts the first address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }

    # For public/VPN access, put TLS + authentication in front of the app.
    # The application itself has no login by design.
    #
    # auth_basic "WarpWeft";
    # auth_basic_user_file /etc/nginx/.htpasswd;
}
