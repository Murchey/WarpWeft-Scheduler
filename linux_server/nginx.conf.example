# WarpWeft Scheduler — 单域名三入口配置。
#
# 复制到 /etc/nginx/conf.d/warpweft.conf 后，部署者只需要修改 server_name 一行。
#
#   /        产品介绍官网（公开，Nginx 直接提供静态文件，不经过 Node）
#   /site/   官网资源（公开，静态文件）
#   /app/    排课应用（需服务端账号登录）
#   /api/    后端接口（除 /api/health 与 /api/auth/login 外均需登录）
#
# Node 服务保持在 127.0.0.1:4317，不要把它直接暴露到公网。
# 公网部署必须启用 TLS：sudo certbot --nginx -d <你的域名> --redirect

upstream warpweft_server {
    server 127.0.0.1:4317;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;

    # ★★★ 部署时唯一必改项：改成你自己的子域名 ★★★
    # 例如：server_name warpweft.example.edu;
    server_name _;

    # 整个工作区作为一个 JSON 文档保存（服务端上限 5 MiB）
    client_max_body_size 8m;

    # ---------- 1) 官网资源：完全绕过 Node ----------
    # 官网的 base 是 /site/，所有资源都落在这里，永远不会与应用 bundle 撞车。
    location ^~ /site/assets/ {
        root /opt/warpweft/dist;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }
    location ^~ /site/ {
        root /opt/warpweft/dist;
        # 禁止回落：若落到 Node 的 SPA 兜底会返回 text/html，浏览器会拒绝执行 module 导致白屏
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
        access_log off;
    }

    # ---------- 2) 官网首页 ----------
    location = / {
        root /opt/warpweft/dist;
        try_files /site/index.html =404;
        default_type text/html;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    # /index.html 历史上是应用入口，现在让给官网
    location = /index.html { return 301 /; }
    location = /site/      { return 301 /; }

    # ---------- 3) 排课应用 ----------
    # 统一收敛到带尾斜杠的 /app/，相对路径解析才唯一确定
    location = /app { return 301 /app/$is_args$args; }

    location ^~ /app/ {
        # proxy_pass 带 URI("/")：Nginx 把 /app/ 前缀替换掉再转发，
        #   /app/            -> /            -> dist/index.html（应用入口）
        #   /app/assets/x.js -> /assets/x.js -> dist/assets/x.js（真实文件）
        #   /app/未知路径     -> Node 的 SPA 兜底 -> 应用入口
        proxy_pass http://warpweft_server/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 覆盖而非追加：应用只信任第一个地址
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        # 长时求解结果流式返回，必须关闭缓冲
        proxy_buffering off;
    }

    # ---------- 4) 兜底：应用 bundle 的根路径形态 ----------
    # 兼容 /app（无尾斜杠）下解析出的 /assets/*，也作为上一段漏配时的缓冲
    location ^~ /assets/ {
        proxy_pass http://warpweft_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }

    # ---------- 5) 后端接口 ----------
    location ^~ /api/ {
        proxy_pass http://warpweft_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }

    # ---------- 6) 其余路径交给 Node（如 /icon.svg） ----------
    location / {
        proxy_pass http://warpweft_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }

    # Basic Auth 是可选的第二层保护。
    # ★ 只能放在 /app/ 或 /api/ 的 location 内部——写在 server 级会把本应公开的官网首页也加上弹窗。
    #
    # auth_basic "WarpWeft";
    # auth_basic_user_file /etc/nginx/.htpasswd;
}
