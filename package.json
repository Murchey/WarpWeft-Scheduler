{
  "name": "warpweft-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "WarpWeft Scheduler single-machine MVP",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node scripts/dev-api.cjs",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build:solver && node --test tests/*.test.cjs",
    "solver": "java -jar resources/solver/warpweft-solver.jar",
    "validate": "node scripts/validate-demo.cjs",
    "desktop": "electron .",
    "build:solver": "powershell -ExecutionPolicy Bypass -File services/solver-java/build.ps1",
    "dist:win": "npm run build && electron-builder --win nsis",
    "prebuild": "npm run build:solver",
    "predev:api": "npm run build:solver",
    "prevalidate": "npm run build:solver"
  },
  "dependencies": {
    "@heroui/react": "^2.7.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.warpweft.scheduler",
    "productName": "WarpWeft Scheduler",
    "asar": true,
    "files": [
      "dist/**/*",
      "apps/desktop/**/*",
      "database/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/solver",
        "to": "solver",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
